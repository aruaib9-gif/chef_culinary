{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node src/index.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.js",
    "seed:demo": "SEED_DEMO=1 node --env-file-if-exists=.env src/db/seed.js",
    "release": "npm run migrate && npm run seed",
    "test": "node --env-file-if-exists=.env --test test/*.test.js",
    "jobs:daily": "node --env-file-if-exists=.env src/jobs/daily.js"
  },
  "dependencies": {
    "@cca/shared": "*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.9"
  }
}
