PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chefs_academy
# Long random string; used to hash session tokens and one-time codes. Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string

# Frontend URLs (used in emails, QR codes, Paystack callbacks and as the default CORS allow-list)
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Optional explicit CORS allow-list (comma-separated); defaults to WEB_URL and ADMIN_URL
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# First super admin, created by `npm run seed` only if none exists
SEED_ADMIN_EMAIL=admin@chefsculinary.com
# Quote the value if it contains # (e.g. "pa#ss-word")
SEED_ADMIN_PASSWORD=

# Paystack (leave empty to disable online payments)
PAYSTACK_SECRET_KEY=

# Email. Without SMTP_HOST, emails are printed to the console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=The Chefs Culinary Academy <no-reply@thechefsculinaryacademy.com>
ADMIN_NOTIFY_EMAILS=
