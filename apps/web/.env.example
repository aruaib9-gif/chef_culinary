# Public config (exposed to the browser — never put secrets here)

# Where the API lives. Leave empty to use /api on this site's own address (recommended: works with the
# dev-server proxy, the VPS setup and any host that forwards /api). Set it only if the API has its own domain,
# e.g. VITE_API_URL=https://api.thechefsculinaryacademy.com
VITE_API_URL=

# Development only: where the Vite dev server forwards /api requests (default http://localhost:4000)
API_PROXY_TARGET=

VITE_PAYSTACK_PUBLIC_KEY=
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
