# Where the API lives. Leave empty to use /api on this site's own address (recommended).
# Set it only if the API has its own domain, e.g. VITE_API_URL=https://api.thechefsculinaryacademy.com
VITE_API_URL=

# Development only: where the Vite dev server forwards /api requests (default http://localhost:4000)
API_PROXY_TARGET=
