# Copy to .env.local for development. On Vercel, add these under Project → Settings → Environment Variables.

# MongoDB Atlas connection string (Atlas → Connect → Drivers). Must be a replica set (all Atlas clusters are).
# Local development without installing MongoDB: run `npm run db:local` and use the line below.
MONGODB_URI=mongodb://127.0.0.1:27017/chefs_academy?replicaSet=rs0

# Long random string (e.g. `openssl rand -hex 32`). Changing it signs everyone out.
JWT_SECRET=

# Public address of the site, no trailing slash. On Vercel this defaults to the production domain.
SITE_URL=http://localhost:3000

# First super admin, created by `npm run seed` only if none exists. Quote values that contain #.
SEED_ADMIN_EMAIL=admin@thechefsculinary.com
SEED_ADMIN_PASSWORD=

# File storage. "local" saves to .uploads/ (development only). Production: any S3-compatible bucket,
# e.g. Cloudflare R2 (S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto).
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Protects the daily job endpoint; Vercel Cron sends it automatically. Any long random string.
CRON_SECRET=

# Email (e.g. Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USER=resend, SMTP_PASS=re_…).
# Without SMTP_HOST, emails are printed to the server log instead of being sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=The Chefs Culinary Academy <no-reply@yourdomain.com>
ADMIN_NOTIFY_EMAILS=

# Paystack secret key (sk_test_… or sk_live_…). Leave empty to disable online payments.
PAYSTACK_SECRET_KEY=

# Only if the API is hosted somewhere else; leave empty to use /api on the same site.
NEXT_PUBLIC_API_URL=
